{
  "name": "shiftflow-backend",
  "version": "1.0.0",
  "description": "ShiftFlow Enterprise Shift Management System - Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node -r dotenv/config src/server.js dotenv_config_path=.env.development",
    "start:prod": "node -r dotenv/config src/server.js dotenv_config_path=.env.production",
    "dev": "nodemon -r dotenv/config src/server.js dotenv_config_path=.env.development",
    "dev:prod": "nodemon -r dotenv/config src/server.js dotenv_config_path=.env.production",
    "test": "NODE_ENV=test jest --coverage",
    "lint": "eslint src/**/*.js",
    "seed": "node -r dotenv/config src/utils/seed.js dotenv_config_path=.env.development",
    "seed:prod": "node -r dotenv/config src/utils/seed.js dotenv_config_path=.env.production"
  },
  "keywords": [
    "shift-management",
    "scheduling",
    "workforce",
    "enterprise"
  ],
  "author": "ShiftFlow Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.44",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "redis": "^4.6.11",
    "socket.io": "^4.6.0",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
