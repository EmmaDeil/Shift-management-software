# Production Environment Variables

# Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1

# MongoDB Configuration - Use Atlas or production cluster
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shiftflow?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://username:password@cluster.mongodb.net/shiftflow_test?retryWrites=true&w=majority

# Redis Configuration - Use production Redis server
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your_production_redis_password

# JWT Configuration - MUST BE STRONG AND UNIQUE
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_256_BIT_MINIMUM
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_STRONG_RANDOM_SECRET
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Configuration (SMTP) - Use SendGrid, Mailgun, AWS SES
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ShiftFlow

# AWS S3 Configuration - Production bucket
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_S3_BUCKET=shiftflow-uploads-prod
AWS_S3_REGION=us-east-1

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=60
CSRF_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_CSRF_SECRET

# Rate Limiting - Stricter for production
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# 2FA Configuration
TWO_FACTOR_APP_NAME=ShiftFlow

# Frontend URL - Your production domain
FRONTEND_URL=https://yourdomain.com

# CORS Origins (comma-separated) - Only your production domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Debug/Logging
LOG_LEVEL=error
ENABLE_QUERY_LOGGING=false
